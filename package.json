{
  "name": "freesls",
  "version": "0.2.4",
  "description": "Offline API Gateway & AWS Lambda runner for Serverless Framework & AWS SAM with TypeScript and SSM support",
  "type": "module",
  "bin": {
    "freesls": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "watch": "tsc --watch",
    "debug": "npm run build && node dist/cli.js -s dev -p 4000 --profile myth-dev --show-env",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwery2052/freesls.git"
  },
  "bugs": {
    "url": "https://github.com/qwery2052/freesls/issues"
  },
  "homepage": "https://github.com/qwery2052/freesls#readme",
  "keywords": [
    "serverless",
    "offline",
    "aws",
    "lambda",
    "api-gateway",
    "ssm",
    "typescript",
    "local-development"
  ],
  "author": "myth_dev",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1127.0",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.8.2",
    "yaml": "^2.9.0"
  }
}
